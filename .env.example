# SecureShield WAF Environment Configuration
# Required: a random secret of at least 32 characters used to sign login tokens.
# The app refuses to start without one. Generate it with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECURESHIELD_SECRET_KEY=change-me-generate-a-random-secret
SECURESHIELD_HOST=127.0.0.1
SECURESHIELD_PORT=8000
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW_SECONDS=10
